{
    "name": "excho0/haven-core",
    "description": "Core supplier and admin utilities for WooCommerce.",
    "type": "wordpress-plugin",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "HavenCore\\": "include/"
        },
        "classmap": [
            "include/"
        ]
    },
    "authors": [
        {
            "name": "excho0",
            "email": "[redacted]"
        }
    ],
    "require": {},
    "require-dev": {
        "robmorgan/phinx": "^0.16.10"
    },
    "scripts": {
        "migrate": "vendor/bin/phinx migrate -c phinx.php",
        "migrate:rollback": "vendor/bin/phinx rollback -c phinx.php -t 0"
    }
}
